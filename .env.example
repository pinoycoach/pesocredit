# Copy to .env (or .env.local) to use these locally. In production set them in the
# hosting provider's environment settings. Both are optional; nothing breaks without them.

# Where the email form sends { "email": "...", "consentedAt": "<ISO time>" } as a JSON POST.
# Leave empty to hide the email form. Must be https (http is accepted only for localhost).
# This value never reaches the browser: the form posts to /api/subscribe on this site,
# which forwards it. Keep any secret in the URL here.
EMAIL_CAPTURE_URL=

# Link to the ₱99 guide, shown below the email form. Leave empty to hide the link.
# Must be an http(s) address.
GUIDE_URL=
