# Copy to .env (or .env.local) to use these locally. In production set them in Netlify's
# environment settings. All are optional; nothing breaks without them.

# The email form (DECISIONS N13). It shows only when all three are set and usable. Each new
# subscriber's address and consent time are emailed to SUBSCRIBE_NOTIFY_TO through Resend.
# None of these ever reaches the browser: the form posts to /api/subscribe on this site.
# Under a dev server the form shows only with `netlify dev`, where /api/subscribe exists.
#
# A Resend key with **Sending access**, restricted to the peso.credit domain. Never the
# Full-access key: that one stays with Napoleon and never goes in a file or on the host.
RESEND_API_KEY=
# The inbox that receives each new subscriber's address.
SUBSCRIBE_NOTIFY_TO=
# The sender, on the verified domain, e.g.: peso.credit <subscribe@peso.credit>
SUBSCRIBE_FROM=

# Link to the ₱99 guide, shown below the email form. Leave empty to hide the link.
# Must be an http(s) address.
GUIDE_URL=
